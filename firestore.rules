rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read, write, update, delete their own document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
