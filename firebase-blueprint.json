{
  "entities": [
    {
      "name": "User",
      "collection": "users",
      "fields": [
        { "name": "uid", "type": "string", "description": "Firebase Auth User ID" },
        { "name": "email", "type": "string", "description": "User email address" },
        { "name": "displayName", "type": "string", "description": "User display name" },
        { "name": "createdAt", "type": "string", "description": "Creation ISO date string" },
        { "name": "lastLoginAt", "type": "string", "description": "Last login ISO date string" }
      ]
    },
    {
      "name": "UserFile",
      "collection": "users/{userId}/files",
      "fields": [
        { "name": "id", "type": "string", "description": "Unique file metadata record ID" },
        { "name": "fileName", "type": "string", "description": "Name of uploaded file" },
        { "name": "fileSize", "type": "number", "description": "File size in bytes" },
        { "name": "fileType", "type": "string", "description": "MIME type" },
        { "name": "uploadDate", "type": "string", "description": "Upload ISO timestamp" },
        { "name": "paraNumber", "type": "number", "description": "Optional Para number (1-30) for Quran PDFs" }
      ]
    },
    {
      "name": "UserAppData",
      "collection": "users/{userId}/data",
      "fields": [
        { "name": "state", "type": "object", "description": "Synced AppState (namaz, duas, goals, etc.)" },
        { "name": "updatedAt", "type": "string", "description": "Last synced timestamp" }
      ]
    }
  ]
}
